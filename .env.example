ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
ANGEL_TOTP=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=
LIVE_TRADING_ENABLED=false
AUTO_UPGRADE=false
AUTO_PAID_RESOURCE_CREATION=false
MONTHLY_AUTHORISED_OVERAGE_INR=0
MARKET_DATA_ENABLED=false
ORDER_API_ENABLED=false
VITE_API_BASE_URL=
